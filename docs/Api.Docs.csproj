<Project Sdk="Microsoft.NET.Sdk">

  <!-- Documentation-only project. Never built for production.
       Uses Microsoft.NET.Sdk (no Razor SDK) so DocFX loads without analyzer errors,
       while still linking to the real source files for accurate "View Source" links. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Api</AssemblyName>
    <RootNamespace>RinhaBackend</RootNamespace>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../src/Api/**/*.cs" Exclude="../src/Api/obj/**;../src/Api/bin/**" />
  </ItemGroup>

</Project>
